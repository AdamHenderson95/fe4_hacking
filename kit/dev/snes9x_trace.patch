index 0000000..1c21bfa
--- /dev/null
+++ b/trace.h
@@ -0,0 +1,9 @@
+#ifndef _TRACE_H_
+#define _TRACE_H_
+#include <stdint.h>
+extern int      trace_on;
+extern uint32_t trace_pc;
+void trace_read(const uint8_t *p, int n);
+void trace_write(const uint8_t *p, int n);
+void trace_exec(const uint8_t *p);
+#endif
