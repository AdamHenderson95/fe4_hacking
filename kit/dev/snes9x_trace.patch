diff --git a/trace.cpp b/trace.cpp
new file mode 100644
index 0000000..261b569
--- /dev/null
+++ b/trace.cpp
@@ -0,0 +1,42 @@
+// Read/write/exec tracing for reverse engineering (fe4 project).
+#include "snes9x.h"
+#include "memmap.h"
+#include "trace.h"
+#include <string.h>
+static void trace_ram_read(const uint8_t *p, int n);
+int      trace_on = 0;
+uint32_t trace_pc = 0;
+static uint32_t rom_reader[0x800000];   // last PC+1 that read each ROM byte
+static uint8_t  rom_exec[0x800000];     // opcode-fetch flags
+static uint32_t ram_writer[0x20000];    // last PC+1 that wrote each WRAM byte
+static uint32_t ram_reader[0x20000];    // last PC+1 that read each WRAM byte
+void trace_read(const uint8_t *p, int n) {
+    if (p >= Memory.ROM && p < Memory.ROM + 0x800000) {
+        size_t o = p - Memory.ROM;
+        for (int i = 0; i < n && o + i < 0x800000; i++) rom_reader[o + i] = trace_pc + 1;
+    } else trace_ram_read(p, n);
+}
+static void trace_ram_read(const uint8_t *p, int n) {
+    if (p >= Memory.RAM && p < Memory.RAM + 0x20000) {
+        size_t o = p - Memory.RAM;
+        for (int i = 0; i < n && o + i < 0x20000; i++) ram_reader[o + i] = trace_pc + 1;
+    }
+}
+void trace_write(const uint8_t *p, int n) {
+    if (p >= Memory.RAM && p < Memory.RAM + 0x20000) {
+        size_t o = p - Memory.RAM;
+        for (int i = 0; i < n && o + i < 0x20000; i++) ram_writer[o + i] = trace_pc + 1;
+    }
+}
+void trace_exec(const uint8_t *p) {
+    if (p >= Memory.ROM && p < Memory.ROM + 0x800000) rom_exec[p - Memory.ROM] = 1;
+}
+extern "C" {
+void     fe4_trace_enable(int on) { trace_on = on; }
+void     fe4_trace_clear(void) { memset(rom_reader, 0, sizeof rom_reader); memset(rom_exec, 0, sizeof rom_exec); memset(ram_writer, 0, sizeof ram_writer); memset(ram_reader, 0, sizeof ram_reader); }
+uint32_t *fe4_trace_rom_reader(void) { return rom_reader; }
+uint8_t  *fe4_trace_rom_exec(void) { return rom_exec; }
+uint32_t *fe4_trace_ram_writer(void) { return ram_writer; }
+uint32_t *fe4_trace_ram_reader(void) { return ram_reader; }
+uint32_t  fe4_cpu_pc(void) { return Registers.PBPC; }
+}
